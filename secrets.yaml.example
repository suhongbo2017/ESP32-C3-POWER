# 复制为 secrets.yaml 后填写真实值 —— secrets.yaml 已加入 .gitignore，不会进仓库。
#
#   cp secrets.yaml.example secrets.yaml
#
# 生成 api_key:  openssl rand -base64 32
# 生成密码:      openssl rand -base64 12

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# 连不上家里 Wi-Fi 时，设备自己开的热点（至少 8 位）
ap_password: "CHANGE_ME_AP_PASSWORD"

# 网页 OTA 上传固件用的密码
ota_password: "CHANGE_ME_OTA_PASSWORD"

# web_server 页面登录（用户名固定 admin，与旧固件一致）
web_password: "CHANGE_ME_WEB_PASSWORD"

# 与 Home Assistant 通信的加密密钥
api_key: "PASTE_BASE64_32_BYTE_KEY_HERE"

# 仅在启用 MQTT 时需要
mqtt_host: "mqtt.19831018.xyz"
mqtt_username: "device-pc-power-c3-001"
mqtt_password: "CHANGE_ME_DEVICE_MQTT_PASSWORD"